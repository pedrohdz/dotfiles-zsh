# Agent-only settings, loaded by agent-harness-wrapper for every harness
# launch. They let git and gh work through agent-vault: SSH remotes are
# rewritten to HTTPS and credential helpers are blanked, so the credential is
# injected on the wire. Nothing here is a real token.
GH_PAGER=cat
GIT_PAGER=cat
GIT_TERMINAL_PROMPT=0
GIT_SSH_COMMAND=false
GIT_CONFIG_COUNT=3
GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf
GIT_CONFIG_VALUE_0=ssh://git@github.com/
GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf
GIT_CONFIG_VALUE_1=git@github.com:
GIT_CONFIG_KEY_2=credential.helper
GIT_CONFIG_VALUE_2=
