{
  "editorMode": "vim",
  "theme": "auto",
  "statusLine": {
    "type": "command",
    "command": "/home/pedro/.local/bin/claude-status"
  },
  "autoUpdatesChannel": "stable",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "*.anthropic.com",
        "*.crates.io",
        "crates.io",
        "docs.ansible.com",
        "docs.python.org",
        "docs.rs",
        "files.pythonhosted.org",
        "galaxy.ansible.com",
        "*.github.com",
        "github.com",
        "*.githubusercontent.com",
        "*.hashicorp.com",
        "*.nix.dev",
        "nix.dev",
        "*.nixos.org",
        "nixos.org",
        "*.npmjs.com",
        "pypi.org",
        "registry.npmjs.org",
        "registry.terraform.io",
        "*.rust-lang.org",
        "rust-lang.org"
      ],
      "allowAllUnixSockets": false,
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyWrite": [
        "~",
        "**/secrets.auto.tfvars",
        "**/secrets.auto.tfvars-*"
      ],
      "allowWrite": [
        "/data/dev",
        "~/dev",
        "~/tmp"
      ],
      "denyRead": [
        "~",
        "**/secrets.auto.tfvars",
        "**/secrets.auto.tfvars-*",
        "~/.agent-harness-wrapper",
        "~/.agent-vault/session.json",
        "~/.homesick",
        "/private/tmp/tmux-*",
        "/run/user/*/gnupg",
        "/run/user/*/ssh-agent.socket",
        "/run/user/*/wezterm-mux-server.sock",
        "/tmp/screens/S-*",
        "/tmp/ssh-*/agent.*",
        "/tmp/tmux-*",
        "/tmp/wezterm-*.sock",
        "/var/run/screen/S-*"
      ],
      "allowRead": [
        "~/.agent-vault/mitm-ca.pem",
        "~/.cargo",
        "~/.config/bat",
        "~/.config/fd",
        "~/.config/git",
        "~/.config/home-manager",
        "~/.config/nix",
        "~/.config/rg",
        "~/.config/systemd",
        "/data/dev",
        "~/dev",
        "~/.dotnet",
        "~/.local",
        "~/.nix-defexpr",
        "~/.nix-profile",
        "~/.npm",
        "~/.nuget",
        "~/.rustup",
        "~/tmp"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(agent-harness-wrapper *)",
      "Bash(agent-vault *)",
      "Bash(agent-vault-wrapper *)",
      "Bash(ansible-playbook *)",
      "Bash(at *)",
