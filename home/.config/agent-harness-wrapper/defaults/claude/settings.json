      "Bash(diskutil *)",
      "Bash(doas *)",
      "Bash(gh-*)",
      "Bash(git push*)",
      "Bash(gpg *)",
      "Bash(gpg2 *)",
      "Bash(hdiutil *)",
      "Bash(keyctl *)",
      "Bash(launchctl *)",
      "Bash(mdfind *)",
      "Bash(networksetup *)",
