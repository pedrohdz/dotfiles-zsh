{
  "editorMode": "vim",
  "theme": "auto",
  "statusLine": {"type": "command", "command": ""},
  "autoUpdatesChannel": "stable",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "*.anthropic.com",
        "*.crates.io",
        "crates.io",
        "docs.ansible.com",
        "docs.python.org",
        "docs.rs",
        "files.pythonhosted.org",
        "galaxy.ansible.com",
        "*.github.com",
        "github.com",
        "*.githubusercontent.com",
        "*.hashicorp.com",
        "*.nix.dev",
        "nix.dev",
        "*.nixos.org",
        "nixos.org",
        "*.npmjs.com",
        "pypi.org",
        "registry.npmjs.org",
        "registry.terraform.io",
        "*.rust-lang.org",
        "rust-lang.org"
      ],
      "allowAllUnixSockets": false,
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyWrite": ["~"],
      "allowWrite": ["~/dev", "~/tmp"],
      "denyRead": [
        "~",
        "/private/tmp/tmux-*",
        "/run/user/*/gnupg",
        "/run/user/*/ssh-agent.socket",
        "/run/user/*/wezterm-mux-server.sock",
        "/tmp/screens/S-*",
        "/tmp/ssh-*/agent.*",
        "/tmp/tmux-*",
        "/tmp/wezterm-*.sock",
        "/var/run/screen/S-*"
      ],
      "allowRead": [
        "~/.cargo",
        "~/.config/bat",
        "~/.config/fd",
        "~/.config/git",
        "~/.config/home-manager",
        "~/.config/nix",
        "~/.config/rg",
        "~/.config/systemd",
        "~/dev",
        "~/.dotnet",
        "~/.local",
        "~/.nix-defexpr",
        "~/.nix-profile",
        "~/.npm",
        "~/.nuget",
        "~/.rustup",
        "~/tmp"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(ansible-playbook *)",
      "Bash(at *)",
      "Bash(aws *)",
      "Bash(byobu *)",
      "Bash(crontab *)",
      "Bash(defaults *)",
      "Bash(diskutil *)",
      "Bash(doas *)",
      "Bash(git push*)",
      "Bash(gpg *)",
      "Bash(gpg2 *)",
      "Bash(hdiutil *)",
      "Bash(keyctl *)",
      "Bash(launchctl *)",
      "Bash(mdfind *)",
      "Bash(networksetup *)",
      "Bash(osascript *)",
      "Bash(pass *)",
      "Bash(pbcopy *)",
      "Bash(pbpaste *)",
      "Bash(pkexec *)",
      "Bash(scp *)",
      "Bash(screen *)",
      "Bash(screencapture *)",
      "Bash(secret-tool *)",
      "Bash(security *)",
      "Bash(sftp *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(sudoedit *)",
      "Bash(system_profiler *)",
      "Bash(terraform * apply*)",
      "Bash(terraform apply*)",
      "Bash(terraform * destroy*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * force-unlock*)",
      "Bash(terraform force-unlock*)",
      "Bash(tmux *)",
      "Bash(tmx *)",
      "Bash(wezterm *)",
      "Bash(wezterm-gui *)",
      "Bash(wezterm-mux-server *)",
      "Bash(wl-copy *)",
      "Bash(wl-paste *)",
      "Bash(xclip *)",
      "Bash(xsel *)",
      "Bash(zellij *)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/github-copilot/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.password-store/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/github-copilot/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.config/gh/**)",
      "Write(~/.config/github-copilot/**)",
      "Write(~/.gnupg/**)",
      "Write(~/.password-store/**)",
      "Write(~/.ssh/**)"
    ]
  }
}
