#! /usr/bin/env bash

set -o pipefail
set -o errexit
set -o nounset

_WRAPPER_DIR="${AGENT_VAULT_WRAPPER_DIR:-${HOME}/.config/agent-vault-wrapper}"
_ENV_DIR="${_WRAPPER_DIR}/envs"
_TOOLS_DIR="${_WRAPPER_DIR}/tools"
_AGENT_VAULT_BIN="${AGENT_VAULT_BIN:-agent-vault}"

# Vault naming (<account>-<purpose>-<access>) lives in a library shared with
# agent-harness-wrapper. Only symlink mode builds a name, so only it loads it.
_LIB_DIR="${AGENT_VAULT_WRAPPER_LIB:-${HOME}/.local/lib/agent-vault-wrapper}"

_BLANK_OR_COMMENT_RE='^[[:space:]]*(#|$)'
_VAR_NAME_RE='^[A-Za-z_][A-Za-z0-9_]*$'
# Canonical --env-name: '/'-separated components, each non-empty and not
# starting with '.', so a valid name always normalizes to itself.
_ENV_NAME_RE='^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$'
# Symlink-mode tool name: it names tools/<tool> and envs/<tool>.env, so a plain
# word that cannot reach another path.
_TOOL_RE='^[A-Za-z0-9_][A-Za-z0-9._]*$'


# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
_VAULT=""
_CMD=""
_CMD_ARGS=()

# --env / --env-file / --env-name / --env-all flags in the order given, as
# "env:KEY=VALUE", "file:PATH", "name:NAME" or "all:". Applied after parsing so
# common.env always loads first and --env always loads last.
_SOURCES=()

# Merged environment for the wrapped command. _ENV_KEYS and _ENV_ORIGINS run
# parallel to _ENV_ARGS so a later value can replace an earlier one and the
# warning can name both places.
_ENV_KEYS=()
_ENV_ARGS=()
_ENV_ORIGINS=()


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
fatal() {
  echo "FATAL - $*" >&2
  exit 1
}

warn() {
  echo "WARN - $*" >&2
}

print_status() {
  if [[ -t 2 ]]; then
    printf '\033[1m%s\033[0m: \033[36m%s\033[0m → \033[36m%s\033[0m\n' \
      "${0##*/}" "$_VAULT" "$_CMD" >&2
  else
    printf '%s: %s → %s\n' "${0##*/}" "$_VAULT" "$_CMD" >&2
  fi
}

usage() {
  cat <<EOF
Usage: ${0##*/} --vault <name> [--env KEY=VALUE]... [--env-file PATH]... \\
           [--env-name NAME]... [--env-all] -- <cmd> [args...]
       <tool>-<account> [TOOL_ARGS...]    (symlink mode, see below)

Run a command under an Agent Vault session scoped to a vault, with extra
environment variables set for the wrapped command only.

Symlink mode:
  Invoked through a symlink named <tool>-<account>, the wrapper runs <tool>
  with every argument passed through untouched. It parses no flags of its
  own there, so --help reaches the tool; this help is for direct mode only.
  The vault is <account>-<purpose>-<access>; vault-naming.sh sets the purpose
  and the default access, and AGENT_VAULT_WRAPPER_ACCESS overrides the access.
    ln -s agent-vault-wrapper ~/.local/bin/gh-drounin

  After common.env, the tool gets the envs listed in tools/<tool> (if it
  exists), then its own envs/<tool>.env (if it exists). tools/<tool> names
  shared envs/ files the way --env-name does, one per line, in order; blank
  lines and lines starting with '#' are ignored. For example tools/bash:
    gh
    git-https

Options (direct mode):
  --vault <name>      Vault to scope the session to (required)
  --env KEY=VALUE     Set a variable for the command (repeatable)
  --env-file <path>   Load KEY=VALUE lines from a file (repeatable)
  --env-name NAME     Load envs/NAME.env from the config dir (repeatable);
                      NAME may include subdirectories (acct/jira) and must be
                      canonical: no '.', '..', '//' or leading/trailing '/'
  --env-all           Load every envs/*.env (not common.env, no
                      subdirectories) in sorted order and list the names
                      loaded. Anything added to envs/ is picked up, so keep
                      those files to stubs.
  --help, -h          Show this help and exit

Variables apply in this order: envs/common.env, then --env-file,
--env-name and --env-all as given, then every --env. Env files must not
overlap: a key set by two of them warns, naming both places, and the later
value is used until the config is fixed. --env is the override channel: it
wins over any file wherever it appears on the command line, and still warns.

Env file format: one KEY=VALUE per line. The value is everything after the
first '=', taken literally (no quotes, no expansion). Blank lines and lines
starting with '#' are ignored. Files are parsed, never sourced.

Environment:
  AGENT_VAULT_BIN          Path to the agent-vault binary.
                           Default: $_AGENT_VAULT_BIN
  AGENT_VAULT_WRAPPER_DIR  Config directory. Its envs/ must exist (it may be
                           empty); envs/common.env is read from it. Its
                           tools/ is optional.
                           Default: $_WRAPPER_DIR
  AGENT_VAULT_WRAPPER_ACCESS
                           Access part of the vault name in symlink mode.
                           Default: WRAPPER_DEFAULT_ACCESS in vault-naming.sh
  AGENT_VAULT_WRAPPER_LIB  Directory holding vault-naming.sh (symlink mode).
                           Default: $_LIB_DIR
EOF
}


# ---------------------------------------------------------------------------
# Environment handling
# ---------------------------------------------------------------------------
# A key set twice always warns, even with the same value, and the later value
# is used. Env files must not overlap, so a file over a file is a config error;
# --env (origin "--env") is the override channel and may be intended. --env
# loads last, so a file never replaces an --env value.
set_var() {
  local _key="$1"
  local _value="$2"
  local _origin="$3"
  local _count="${#_ENV_KEYS[@]}"
  local _prev
  local _i

  [[ "$_key" =~ $_VAR_NAME_RE ]] \
    || fatal "Invalid variable name '$_key' ($_origin)"

  for (( _i = 0; _i < _count; _i++ )); do
    if [[ "${_ENV_KEYS[$_i]}" == "$_key" ]]; then
      _prev="${_ENV_ORIGINS[$_i]}"
      if [[ "$_origin" != --env ]]; then
        warn "$_key set in $_prev and $_origin; using $_origin (fix the config)"
      elif [[ "$_prev" == --env ]]; then
        warn "$_key given twice with --env; using the last"
      else
        warn "$_key from $_prev overridden by --env"
      fi
      _ENV_ARGS[_i]="${_key}=${_value}"
      _ENV_ORIGINS[_i]="$_origin"
      return
    fi
  done
  _ENV_KEYS+=("$_key")
  _ENV_ARGS+=("${_key}=${_value}")
  _ENV_ORIGINS+=("$_origin")
}

add_env() {
  local _pair="$1"
  [[ "$_pair" == *=* ]] || fatal "--env requires KEY=VALUE, got: $_pair"
  set_var "${_pair%%=*}" "${_pair#*=}" "--env"
}

load_env_file() {
  local _file="$1"
  local _line
  local _lineno=0

  [[ -f "$_file" && -r "$_file" ]] || fatal "Env file not readable: $_file"

  while IFS= read -r _line || [[ -n "$_line" ]]; do
    _lineno=$(( _lineno + 1 ))
    if [[ "$_line" =~ $_BLANK_OR_COMMENT_RE ]]; then
      continue
    fi
    [[ "$_line" == *=* ]] || fatal "$_file:$_lineno: expected KEY=VALUE"
    set_var "${_line%%=*}" "${_line#*=}" "$_file:$_lineno"
  done < "$_file"
}

# --env-name NAME loads envs/NAME.env from the config directory. NAME may
# include subdirectories (<account>/jira) but must already be in canonical
# form: anything a path normalizer would change (., .., //, a leading or
# trailing /) is rejected, so a name cannot smuggle in a different path.
load_env_name() {
  local _name="$1"
  local _path="$_ENV_DIR/$_name.env"
  # Ranges like A-Z follow the locale's collation order and can match accented
  # letters; match bytewise so the grammar means plain ASCII.
  local LC_ALL=C

  [[ "$_name" =~ $_ENV_NAME_RE ]] \
    || fatal "Invalid --env-name '$_name' (letters, digits, '.', '_', '-', with '/' between non-empty components; a component may not start with '.')"
  [[ -f "$_path" ]] || fatal "No env file named '$_name': $_path"
  load_env_file "$_path"
}

# --env-all loads every envs/*.env directly under the config directory, in
# byte-sorted order, except common.env (already loaded first). Subdirectories
# are not entered. The names are reported so a new file showing up in a launch
# is visible.
load_env_all() {
  local _file
  local _base
  local _names=()
  local LC_ALL=C

  shopt -s nullglob
  for _file in "$_ENV_DIR"/*.env; do
    _base="${_file##*/}"
    [[ "$_base" != common.env && -f "$_file" ]] || continue
    load_env_file "$_file"
    _names+=("${_base%.env}")
  done
  shopt -u nullglob

  echo "${0##*/}: --env-all loaded: ${_names[*]-(none)}" >&2
}

load_env() {
  local _common="$_ENV_DIR/common.env"
  local _source

  # A missing individual file is normal, but a missing directory means the
  # install is incomplete (e.g. not yet relinked). Refuse to run: the command
  # would otherwise start without its stub environment.
  if [[ ! -d "$_ENV_DIR" ]]; then
    fatal "Env directory not found: $_ENV_DIR (install the config, or set AGENT_VAULT_WRAPPER_DIR to a directory containing envs/)"
  fi

  if [[ -f "$_common" ]]; then
    load_env_file "$_common"
  fi

  # Env files in the order given, then --env: it is the override channel, so
  # it wins wherever it appears on the command line.
  for _source in ${_SOURCES[@]+"${_SOURCES[@]}"}; do
    case "$_source" in
      file:*) load_env_file "${_source#file:}" ;;
      name:*) load_env_name "${_source#name:}" ;;
      all:*)  load_env_all ;;
    esac
  done
  for _source in ${_SOURCES[@]+"${_SOURCES[@]}"}; do
    case "$_source" in
      env:*)  add_env "${_source#env:}" ;;
    esac
  done
}

# tools/<tool> lists the shared envs/ files a symlink-mode tool loads, by name
# as for --env-name, one per line and in order. They are queued before the
# tool's own envs/<tool>.env. A line naming common or the tool itself (both
# always load) or repeating an earlier line would only duplicate keys, so it
# warns and is skipped rather than blocking the launch.
load_tool_manifest() {
  local _file="$1"
  local _tool="$2"
  local _line
  local _lineno=0
  local _seen=()
  local _name
  local LC_ALL=C

  [[ -r "$_file" ]] || fatal "Tool manifest not readable: $_file"

  while IFS= read -r _line || [[ -n "$_line" ]]; do
    _lineno=$(( _lineno + 1 ))
    if [[ "$_line" =~ $_BLANK_OR_COMMENT_RE ]]; then
      continue
    fi
    [[ "$_line" =~ $_ENV_NAME_RE ]] \
      || fatal "$_file:$_lineno: invalid env name '$_line' (letters, digits, '.', '_', '-', with '/' between non-empty components; a component may not start with '.')"
    if [[ "$_line" == common || "$_line" == "$_tool" ]]; then
      warn "$_file:$_lineno: '$_line' always loads; skipped"
      continue
    fi
    for _name in ${_seen[@]+"${_seen[@]}"}; do
      if [[ "$_name" == "$_line" ]]; then
        warn "$_file:$_lineno: '$_line' already listed; skipped"
        continue 2
      fi
    done
    [[ -f "$_ENV_DIR/$_line.env" ]] \
      || fatal "$_file:$_lineno: no env file named '$_line': $_ENV_DIR/$_line.env"
    _seen+=("$_line")
    _SOURCES+=("file:$_ENV_DIR/$_line.env")
  done < "$_file"
}


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
# env(1) would read these as its own options or assignments.
check_cmd() {
  [[ "$_CMD" != -* ]] || fatal "Command may not start with '-': $_CMD"
  [[ "$_CMD" != *=* ]] || fatal "Command may not contain '=': $_CMD"
}

configure() {
  while (( $# )); do
    case "$1" in
      -h|--help)
        usage; exit 0 ;;
      --vault)
        [[ $# -ge 2 ]] || fatal "--vault requires a vault name"
        _VAULT="$2"; shift 2 ;;
      --vault=*)
        _VAULT="${1#--vault=}"; shift ;;
      --env)
        [[ $# -ge 2 ]] || fatal "--env requires KEY=VALUE"
        _SOURCES+=("env:$2"); shift 2 ;;
      --env=*)
        _SOURCES+=("env:${1#--env=}"); shift ;;
      --env-file)
        [[ $# -ge 2 ]] || fatal "--env-file requires a path"
        _SOURCES+=("file:$2"); shift 2 ;;
      --env-file=*)
        _SOURCES+=("file:${1#--env-file=}"); shift ;;
      --env-name)
        [[ $# -ge 2 ]] || fatal "--env-name requires a name"
        _SOURCES+=("name:$2"); shift 2 ;;
      --env-name=*)
        _SOURCES+=("name:${1#--env-name=}"); shift ;;
      --env-all)
        _SOURCES+=("all:"); shift ;;
      --)
        shift; break ;;
      -*)
        fatal "Unknown option: $1" ;;
      *)
        fatal "Unexpected argument: $1 (the command goes after --)" ;;
    esac
  done

  [[ -n "$_VAULT" ]] || fatal "--vault is required"
  (( $# )) || fatal "No command given (expected: -- <cmd> [args...])"

  _CMD="$1"
  shift
  _CMD_ARGS=("$@")
  check_cmd
}

# Source the shared vault-naming library, refusing to continue if it is
# missing or incomplete: a wrong or empty vault name must never reach
# agent-vault.
load_naming_lib() {
  local _lib="$_LIB_DIR/vault-naming.sh"

  [[ -f "$_lib" ]] \
    || fatal "Vault naming library not found: $_lib (install the config, or set AGENT_VAULT_WRAPPER_LIB to a directory containing vault-naming.sh)"
  # shellcheck source-path=SCRIPTDIR
  # shellcheck source=../lib/agent-vault-wrapper/vault-naming.sh
  source "$_lib"
  declare -F vault_name >/dev/null \
    && [[ -n "${WRAPPER_DEFAULT_PURPOSE:-}" && -n "${WRAPPER_DEFAULT_ACCESS:-}" ]] \
    || fatal "Vault naming library is incomplete: $_lib (needs vault_name, WRAPPER_DEFAULT_PURPOSE and WRAPPER_DEFAULT_ACCESS)"
}

# Symlink mode: the invoked name is <tool>-<account> and every argument
# belongs to the tool.
configure_symlink() {
  local _self="${0##*/}"
  local _tool="${_self%%-*}"
  local _account="${_self#*-}"
  local LC_ALL=C

  [[ "$_self" == *-* && -n "$_tool" && -n "$_account" ]] \
    || fatal "Invoked as '$_self'; expected <tool>-<account>"
  [[ "$_tool" =~ $_TOOL_RE ]] \
    || fatal "Invalid tool name '$_tool' (letters, digits, '.', '_'; may not start with '.')"

  load_naming_lib
  _VAULT="$(vault_name "$_account" "$WRAPPER_DEFAULT_PURPOSE" \
    "${AGENT_VAULT_WRAPPER_ACCESS:-$WRAPPER_DEFAULT_ACCESS}")"
  _CMD="$_tool"
  _CMD_ARGS=("$@")
  check_cmd

  # Shared envs from the manifest, then the tool's own, so its values come
  # last while an overlap is being fixed.
  if [[ -f "$_TOOLS_DIR/$_tool" ]]; then
    load_tool_manifest "$_TOOLS_DIR/$_tool" "$_tool"
  fi
  if [[ -f "$_ENV_DIR/$_tool.env" ]]; then
    _SOURCES+=("file:$_ENV_DIR/$_tool.env")
  fi
}

# Symlink mode is when the script runs under a name other than its own. If
# the real path can't be resolved, fall back to direct mode.
is_symlink_invocation() {
  local _real
  _real="$(readlink -f "$0" 2>/dev/null)" || return 1
  [[ "${0##*/}" != "${_real##*/}" ]]
}


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_run() {
  command -v "$_AGENT_VAULT_BIN" >/dev/null 2>&1 \
    || fatal "agent-vault binary not found: $_AGENT_VAULT_BIN"
  command -v "$_CMD" >/dev/null 2>&1 \
    || fatal "Command not found: $_CMD"
  load_env
  print_status
  exec "$_AGENT_VAULT_BIN" run --vault "$_VAULT" -- \
    env ${_ENV_ARGS[@]+"${_ENV_ARGS[@]}"} \
      "$_CMD" ${_CMD_ARGS[@]+"${_CMD_ARGS[@]}"}
}


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
if is_symlink_invocation; then
  configure_symlink "$@"
else
  [[ $# -gt 0 ]] || { usage >&2; exit 1; }
  configure "$@"
fi
cmd_run
